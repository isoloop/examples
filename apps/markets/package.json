{
  "name": "markets",
  "private": true,
  "type": "module",
  "description": "A backend-less markets dashboard, as an idiomatic native app and on Isoloop.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode native && vite build --mode isoloop-preact && vite build --mode native-preact && vite build --mode mixed && vite build --mode mixed-preact && node scripts/index-page.ts && node scripts/check-builds.ts",
    "preview": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "record": "node scripts/record.ts",
    "dev:native": "vite --mode native"
  },
  "dependencies": {
    "@isoloop/bus": "catalog:isoloop",
    "@isoloop/host": "catalog:isoloop",
    "@isoloop/preact": "catalog:isoloop",
    "@isoloop/protocol": "catalog:isoloop",
    "@isoloop/react": "catalog:isoloop",
    "@isoloop/runtime": "catalog:isoloop",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "preact": "catalog:preact",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@isoloop/vite": "catalog:isoloop",
    "@playwright/test": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
