{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // ADR 0009, rule 5: every rule is an error or off; type-aware on every run.
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  // Type-aware rules outside the categories above, added by name: promise
  // handling, `any` leaking out of message payloads, and exhaustive switches
  // over message unions.
  "rules": {
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-deprecated": "error",
    // For window.postMessage. Isoloop posts to workers and ports, which take no
    // targetOrigin, so every hit would be a false positive.
    "unicorn/require-post-message-target-origin": "off",
    "no-underscore-dangle": "error"
  },
  // The markets app: code shared by both builds, and the native build itself,
  // never import Isoloop, so /native is an idiomatic app with none of it.
  "overrides": [
    {
      "files": [
        "apps/dashboards/markets/src/core/**",
        "apps/dashboards/markets/src/charts/**",
        "apps/dashboards/markets/src/widgets/**",
        "apps/dashboards/markets/src/native/**",
        "apps/dashboards/markets/src/env/native.ts",
        "apps/dashboards/markets/src/env/hooks.ts",
        "apps/dashboards/markets/src/slot/native.tsx",
        "apps/dashboards/markets/src/main.native.tsx",
        "apps/dashboards/markets/src/page.tsx",
        // The plant app the same way (M3d decision 7): both native builds.
        "apps/dashboards/plant/src/core/**",
        "apps/dashboards/plant/src/charts/**",
        "apps/dashboards/plant/src/widgets/**",
        "apps/dashboards/plant/src/native/**",
        "apps/dashboards/plant/src/env/native.ts",
        "apps/dashboards/plant/src/env/hooks.ts",
        "apps/dashboards/plant/src/slot/native.tsx",
        "apps/dashboards/plant/src/main.native.tsx",
        "apps/dashboards/plant/src/main.native-workers.tsx",
        "apps/dashboards/plant/src/page.tsx",
        "apps/dashboards/plant/src/ClearHistory.tsx",
        "apps/dashboards/plant/src/host/native.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                // @isoloop/codec is a dev dependency of the plant's unit tests.
                "group": ["@isoloop/**", "!@isoloop/codec", "**/isoloop/**", "virtual:isoloop/*"],
                "message": "Shared and native code stays free of Isoloop (M3b task 15)."
              }
            ]
          }
        ]
      }
    }
  ]
}
