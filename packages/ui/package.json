{
  "name": "ui",
  "private": true,
  "type": "module",
  "description": "The design system shared by the site and the examples (ADR 0003): build-time Preact components, tokens, shell CSS, the theme script and a Vite plugin.",
  "exports": {
    "./components": "./src/components/index.ts",
    "./render": "./src/render.ts",
    "./tokens.css": "./src/tokens.css",
    "./shell.css": "./src/shell.css",
    "./theme.js": "./src/theme.js",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "dev": "vite specimens",
    "build:specimens": "vite build specimens --outDir ../dist/specimens --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "brand:marks": "node brand/build/marks.ts",
    "brand:render": "node brand/build/render.ts",
    "brand:social": "node brand/build/marks.ts && node brand/build/render.ts"
  },
  "dependencies": {
    "preact": "catalog:preact",
    "preact-render-to-string": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
