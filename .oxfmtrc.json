{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/*.md",
    "apps/dashboards/plant/architecture/*.html",
    "apps/dashboards/plant/architecture/viewer-*.js",
    "apps/site/.library/**",
    "site/**"
  ]
}
